DB_HOST=localhost
DB_PORT=3306
DB_USER=lms_user
# Set private values before starting Compose. Never commit .env.
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_NAME=lms_db
# Windows setup generates all secrets. Do not publish or overwrite your .env.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174","http://localhost:5173"]
FACE_ENGINE=opencv
FACE_MATCH_THRESHOLD=0.363
FACE_MARGIN_THRESHOLD=0.05
FACE_MIN_HITS=3
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
DEV_FACE_SIMULATOR=false
# Real FaceID uses OpenCV YuNet + SFace. Setup downloads weights separately.
# Set FACE_ENGINE=mock only for tests; it does NOT recognize real faces.
# Encryption key is generated during first Windows setup. Back it up securely.
FACE_EMBEDDING_KEY=
# Hai ngưỡng ở trên chỉ là giá trị tạm. Với SFace, OpenCV Zoo ghi 0.363 cho cosine; PHẢI hiệu chỉnh
# bằng thực nghiệm (backend/face_tools/evaluation) trước khi tin kết quả nhận diện.
# FACE_MIN_FACE_PIXELS=100
# FACE_IDENTIFY_MIN_FACE_PIXELS=64

# M3a: session lifecycle and attendance
SESSION_OPEN_BEFORE_MIN=30
SESSION_OPEN_AFTER_END_MIN=60
SESSION_AUTO_CLOSE_AFTER_END_MIN=120
EDIT_AFTER_CLOSE_HOURS=24
# Demo only; false by default (usage is audited)
DEV_ALLOW_OPEN_ANYTIME=false
APP_ENV=development

# These two example thresholds are NOT a validated recognition accuracy claim.
# Calibrate with backend/face_tools/evaluation before the thesis demo.
